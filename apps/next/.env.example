# Surf Engine base URL (embedded at build time; used by Transfer + notifications registration)
# - local dev (engine running on same Next dev server): http://localhost:3000
# - deployed: https://<your-backend-domain>
NEXT_PUBLIC_ENGINE_URL=http://localhost:3000

# Optional: if you want to override any "API origin" lookups for Next routes (not required by code today)
# NEXT_PUBLIC_API_URL=http://localhost:3000

# Optional mock user until JWT auth is wired
# NEXT_PUBLIC_SURF_ENGINE_USER_ID=demo-user

